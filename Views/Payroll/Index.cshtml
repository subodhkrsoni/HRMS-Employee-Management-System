@model IEnumerable<EmployeeManagementSystem.Models.Payroll>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Payroll Management";

    var payrolls = Model.ToList();

    var totalPayroll = payrolls.Sum(p => p.NetSalary);

    var pendingCount =
        payrolls.Count(p => p.PaymentStatus == "Pending");

    var paidCount =
        payrolls.Count(p => p.PaymentStatus == "Paid");

    var pendingAmount =
        payrolls
            .Where(p => p.PaymentStatus == "Pending")
            .Sum(p => p.NetSalary);
}

<div class="container-fluid">

    <!-- ========================================== -->
    <!-- ALERTS -->
    <!-- ========================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================== -->
    <!-- HEADER -->
    <!-- ========================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-cash-stack me-2"></i>

                Payroll Management

            </h2>

            <p class="text-muted mb-0">

                Manage employee salary and payroll payments.

            </p>

        </div>


        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle me-2"></i>

            Create Payroll

        </a>

    </div>


    <!-- ========================================== -->
    <!-- STATISTICS -->
    <!-- ========================================== -->

    <div class="row g-3 mb-4">


        <!-- Total Payroll -->

        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h6 class="text-muted">
                                Total Payroll
                            </h6>

                            <h3 class="fw-bold">
                                ₹ @totalPayroll.ToString("N2")
                            </h3>

                        </div>

                        <i class="bi bi-wallet2 fs-1 text-primary"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Pending -->

        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h6 class="text-muted">
                                Pending
                            </h6>

                            <h3 class="fw-bold text-warning">
                                @pendingCount
                            </h3>

                        </div>

                        <i class="bi bi-hourglass-split fs-1 text-warning"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Paid -->

        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h6 class="text-muted">
                                Paid Payroll
                            </h6>

                            <h3 class="fw-bold text-success">
                                @paidCount
                            </h3>

                        </div>

                        <i class="bi bi-check-circle fs-1 text-success"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Pending Amount -->

        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h6 class="text-muted">
                                Pending Amount
                            </h6>

                            <h3 class="fw-bold text-danger">
                                ₹ @pendingAmount.ToString("N2")
                            </h3>

                        </div>

                        <i class="bi bi-currency-rupee fs-1 text-danger"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================== -->
    <!-- PAYROLL TABLE -->
    <!-- ========================================== -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-dark text-white">

            <h5 class="mb-0">

                <i class="bi bi-table me-2"></i>

                Payroll Records

            </h5>

        </div>


        <div class="card-body">

            <div class="table-responsive">

                <table id="payrollTable"
                      class="table table-striped table-hover table-bordered align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>#</th>

                            <th>Employee</th>

                            <th>Period</th>

                            <th>Basic Salary</th>

                            <th>Allowances</th>

                            <th>Deductions</th>

                            <th>Net Salary</th>

                            <th>Status</th>

                            <th>Payment Date</th>

                            <th width="220">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            int counter = 1;
                        }

                        @foreach (var item in payrolls)
                        {

                            string monthName =
                                new DateTime(
                                    item.PayrollYear,
                                    item.PayrollMonth,
                                    1)
                                .ToString("MMM yyyy");


                            <tr>

                                <!-- Number -->

                                <td>
                                    @counter
                                </td>


                                <!-- Employee -->

                                <td>

                                    <strong>
                                        @item.Employee?.Name
                                    </strong>

                                    <br />

                                    <small class="text-muted">

                                        @item.Employee?.EmployeeCode

                                    </small>

                                </td>


                                <!-- Period -->

                                <td>

                                    <span class="badge bg-secondary">

                                        @monthName

                                    </span>

                                </td>


                                <!-- Basic -->

                                <td>

                                    ₹ @item.BasicSalary.ToString("N2")

                                </td>


                                <!-- Allowances -->

                                <td class="text-success">

                                    + ₹ @item.Allowances.ToString("N2")

                                </td>


                                <!-- Deductions -->

                                <td class="text-danger">

                                    - ₹ @item.Deductions.ToString("N2")

                                </td>


                                <!-- Net -->

                                <td>

                                    <strong>

                                        ₹ @item.NetSalary.ToString("N2")

                                    </strong>

                                </td>

                                <!-- Status -->

                                <td>

                                    @if (item.PaymentStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">

                                            <i class="bi bi-hourglass-split me-1"></i>

                                            Pending

                                        </span>
                                    }
                                    else if (item.PaymentStatus == "Paid")
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-check-circle me-1"></i>

                                            Paid

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            @item.PaymentStatus

                                        </span>
                                    }

                                </td>


                                <!-- Payment Date -->

                                <td>

                                    @if (item.PaymentDate.HasValue)
                                    {
                                        @item.PaymentDate.Value.ToString("dd-MM-yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Not Paid
                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    @if (item.PaymentStatus == "Pending")
                                    {
                                        <!-- Details -->
                                        <a asp-action="Details"
                                           asp-route-id="@item.PayrollId"
                                           class="btn btn-info btn-sm"
                                           title="Details">

                                            <i class="bi bi-eye-fill"></i>

                                        </a>

                                        <!-- Edit -->
                                        <a asp-action="Edit"
                                           asp-route-id="@item.PayrollId"
                                           class="btn btn-warning btn-sm"
                                           title="Edit">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                        <!-- Mark Paid -->
                                        <button type="button"
                                                class="btn btn-success btn-sm"
                                                title="Mark as Paid"
                                                onclick="markAsPaid(@item.PayrollId)">

                                            <i class="bi bi-check-lg"></i>

                                        </button>

                                        <!-- Delete -->
                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                title="Delete"
                                                onclick="deletePayroll(@item.PayrollId)">

                                            <i class="bi bi-trash"></i>

                                        </button>

                                        <!-- Hidden Mark Paid Form -->
                                        <form id="paidForm-@item.PayrollId"
                                              asp-action="MarkAsPaid"
                                              method="post"
                                              class="d-none">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.PayrollId" />

                                        </form>

                                        <!-- Hidden Delete Form -->
                                        <form id="deleteForm-@item.PayrollId"
                                              asp-action="Delete"
                                              method="post"
                                              class="d-none">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.PayrollId" />

                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No actions
                                        </span>
                                    }

                                </td>

                            </tr>

                            counter++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        // ==========================================
        // DATATABLE
        // ==========================================

        $(document).ready(function () {

    $('#payrollTable').DataTable({

        responsive: true,

        scrollX: true,

        pageLength: 10,

        lengthMenu: [10, 25, 50, 100],

        ordering: true,

        order: [[2, 'desc']]

    });

});

        // ==========================================
        // MARK AS PAID
        // ==========================================

        function markAsPaid(id) {

            Swal.fire({

                title: 'Mark Payroll as Paid?',

                text:
                    'Payment date will be recorded as today.',

                icon: 'question',

                showCancelButton: true,

                confirmButtonText:
                    '<i class="bi bi-check-lg"></i> Yes, Mark Paid',

                cancelButtonText:
                    'Cancel',

                confirmButtonColor:
                    '#198754'

            }).then((result) => {

                if (result.isConfirmed) {

                    $('#paidForm-' + id)
                        .submit();

                }

            });

        }


        // ==========================================
        // DELETE PAYROLL
        // ==========================================

        function deletePayroll(id) {

            Swal.fire({

                title: 'Delete Payroll?',

                text:
                    'This payroll record will be permanently deleted.',

                icon: 'warning',

                showCancelButton: true,

                confirmButtonText:
                    'Yes, Delete',

                cancelButtonText:
                    'Cancel',

                confirmButtonColor:
                    '#dc3545'

            }).then((result) => {

                if (result.isConfirmed) {

                    $('#deleteForm-' + id)
                        .submit();

                }

            });

        }

    </script>

}