<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - HRMS</title>


    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <!-- DataTables -->
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />

    <link rel="stylesheet"
          href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />


    <!-- Toastr -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

</head>


<body class="bg-light">


<div class="d-flex">


    <!-- ========================================= -->
    <!-- SIDEBAR -->
    <!-- ========================================= -->

    <aside class="bg-dark text-white p-3 position-relative"
           style="width:260px; min-height:100vh;">

        <!-- Logo -->

        <div class="text-center mb-4">

            <h3 class="fw-bold">

                <i class="bi bi-building"></i>

                HRMS

            </h3>

            <small class="text-secondary">
                Human Resource Management
            </small>

        </div>


        <hr />

        <!-- Navigation -->

        <ul class="nav flex-column">


            <!-- Dashboard -->

            <li class="nav-item mb-2">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="nav-link text-white">

                    <i class="bi bi-speedometer2 me-2"></i>

                    Dashboard

                </a>

            </li>


            <!-- Employees -->

            <li class="nav-item mb-2">

                <a asp-controller="Employee"
                   asp-action="Index"
                   class="nav-link text-white">

                    <i class="bi bi-people-fill me-2"></i>

                    Employees

                </a>

            </li>


            <!-- Departments -->

            <li class="nav-item mb-2">

                <a asp-controller="Department"
                   asp-action="Index"
                   class="nav-link text-white">

                    <i class="bi bi-diagram-3-fill me-2"></i>

                    Departments

                </a>

            </li>


            <!-- Attendance -->

            <li class="nav-item mb-2">

                <a asp-controller="Attendance"
                  asp-action="Index"
                  class="nav-link text-white">

                   <i class="bi bi-calendar-check me-2"></i>

                   Attendance

                 </a>

            </li>


            <!-- Leave -->

            <li class="nav-item mb-2">

    <a asp-controller="Leave"
       asp-action="Index"
       class="nav-link text-white">

        <i class="bi bi-calendar-event me-2"></i>

        Leave

    </a>

</li>


            <!-- Payroll -->

                <li class="nav-item mb-2">

                    <a asp-controller="Payroll"
                       asp-action="Index"
                       class="nav-link text-white">

                        <i class="bi bi-cash-stack me-2"></i>

                        Payroll

                    </a>

                </li>


            <!-- Reports -->

            <li class="nav-item mb-2">

                <a asp-controller="Reports"
   asp-action="Index"
   class="nav-link text-white">

    <i class="bi bi-file-earmark-bar-graph me-2"></i>

    Reports

</a>

            </li>


            @if (User.IsInRole("Admin"))
            {

                <hr />

                <!-- Admin Section -->

                <li class="nav-item mb-2">

                    <small class="text-secondary text-uppercase">
                        Administration
                    </small>

                </li>


                <!-- Users -->

                <li class="nav-item mb-2">

                    <a asp-controller="User"
                     asp-action="Index"
                     class="nav-link text-white">

                     <i class="bi bi-person-gear me-2"></i>

                         User Management

                     </a>

                </li>

            }


        </ul>


        <!-- Sidebar Bottom -->

        <div class="position-absolute bottom-0 mb-3">

            <small class="text-secondary">

                HRMS v1.0

            </small>

        </div>


    </aside>



    <!-- ========================================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================================= -->

    <div class="flex-grow-1">


        <!-- ========================================= -->
        <!-- TOP NAVBAR -->
        <!-- ========================================= -->

        <nav class="navbar navbar-light bg-white shadow-sm">

            <div class="container-fluid">


                <!-- Page Title -->

                <span class="navbar-brand fw-bold">

                    @ViewData["Title"]

                </span>


                <!-- User Menu -->

                @if (User.Identity != null &&
                     User.Identity.IsAuthenticated)
                {

                    <div class="dropdown">


                        <button class="btn btn-light dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown">


                            <i class="bi bi-person-circle fs-5"></i>

                            @User.Identity.Name


                        </button>


                        <ul class="dropdown-menu dropdown-menu-end">


                            <!-- User -->

                            <li>

                                <span class="dropdown-item-text">

                                    <strong>

                                        @User.Identity.Name

                                    </strong>

                                </span>

                            </li>


                            <!-- Role -->

                            <li>

                                <span class="dropdown-item-text">

                                    <span class="badge bg-primary">

                                        <i class="bi bi-shield-check"></i>

                                        @User.FindFirst(
                                            System.Security.Claims.ClaimTypes.Role
                                        )?.Value

                                    </span>

                                </span>

                            </li>


                            <li>
                                <hr class="dropdown-divider" />
                            </li>


                            <!-- Logout -->

                            <li>

                                <a class="dropdown-item text-danger"
                                   asp-controller="Account"
                                   asp-action="Logout">

                                    <i class="bi bi-box-arrow-right me-2"></i>

                                    Logout

                                </a>

                            </li>


                        </ul>

                    </div>

                }


            </div>

        </nav>



        <!-- ========================================= -->
        <!-- PAGE CONTENT -->
        <!-- ========================================= -->

        <main class="container-fluid mt-4">

            @RenderBody()

        </main>


    </div>


</div>



<!-- ========================================= -->
<!-- JAVASCRIPT -->
<!-- ========================================= -->

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


<!-- DataTables -->

<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>


<!-- DataTables Responsive -->

<script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

<script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>


<!-- SweetAlert -->

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


<!-- Toastr -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>


<!-- Chart.js -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<!-- Page Scripts -->

@await RenderSectionAsync("Scripts", required: false)


</body>

</html>