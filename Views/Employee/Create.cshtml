@model EmployeeManagementSystem.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "Add Employee";
}

<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header bg-primary text-white">
            <h3>
                <i class="bi bi-person-plus-fill"></i>
                Add New Employee
            </h3>
        </div>

        <div class="card-body">

            <form asp-action="Create"
                  enctype="multipart/form-data">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Employee.EmployeeCode"
                               class="form-label"></label>

                        <input asp-for="Employee.EmployeeCode"
                               class="form-control" />

                        <span asp-validation-for="Employee.EmployeeCode"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Employee.Name"
                               class="form-label"></label>

                        <input asp-for="Employee.Name"
                               class="form-control" />

                        <span asp-validation-for="Employee.Name"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Employee.Email"
                               class="form-label"></label>

                        <input asp-for="Employee.Email"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Employee.Phone"
                               class="form-label"></label>

                        <input asp-for="Employee.Phone"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">

                            Gender

                        </label>

                        <select asp-for="Employee.Gender"
                                class="form-select">

                            <option>Male</option>

                            <option>Female</option>

                            <option>Other</option>

                        </select>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Employee.Designation"
                               class="form-label"></label>

                        <input asp-for="Employee.Designation"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">

                            Department

                        </label>

                        <select asp-for="Employee.DepartmentId"
                                asp-items="Model.Departments"
                                class="form-select">

                            <option value="">Select Department</option>

                        </select>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Employee.Salary"
                               class="form-label"></label>

                        <input asp-for="Employee.Salary"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Employee.JoiningDate"
                               class="form-label"></label>

                        <input asp-for="Employee.JoiningDate"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">

                            Status

                        </label>

                        <select asp-for="Employee.IsActive"
                                class="form-select">

                            <option value="true">Active</option>

                            <option value="false">Inactive</option>

                        </select>

                    </div>

                    <div class="col-md-12 mb-3">

                        <label asp-for="Employee.Address"
                               class="form-label"></label>

                        <textarea asp-for="Employee.Address"
                                  class="form-control"
                                  rows="3"></textarea>

                    </div>

                    <div class="col-md-12 mb-3">

                        <label class="form-label">

                            Employee Photo

                        </label>

                        <input asp-for="Photo"
                               class="form-control"
                               type="file" />

                    </div>

                </div>

                <button class="btn btn-success">

                    <i class="bi bi-check-circle-fill"></i>

                    Save Employee

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Back

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}