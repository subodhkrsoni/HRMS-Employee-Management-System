@model EmployeeManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header bg-primary text-white">
            <h3>
                <i class="bi bi-person-badge-fill"></i>
                Employee Profile
            </h3>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-3 text-center">

                    @if (!string.IsNullOrEmpty(Model.PhotoPath))
                    {
                        <img src="@Model.PhotoPath"
                             class="img-fluid rounded-circle border shadow"
                             style="width:180px;height:180px;object-fit:cover;" />
                    }
                    else
                    {
                        <img src="~/images/default-user.png"
                             class="img-fluid rounded-circle border shadow"
                             style="width:180px;height:180px;object-fit:cover;" />
                    }

                </div>

                <div class="col-md-9">

                    <table class="table table-bordered">

                        <tr>
                            <th width="220">Employee Code</th>
                            <td>@Model.EmployeeCode</td>
                        </tr>

                        <tr>
                            <th>Name</th>
                            <td>@Model.Name</td>
                        </tr>

                        <tr>
                            <th>Email</th>
                            <td>@Model.Email</td>
                        </tr>

                        <tr>
                            <th>Phone</th>
                            <td>@Model.Phone</td>
                        </tr>

                        <tr>
                            <th>Gender</th>
                            <td>@Model.Gender</td>
                        </tr>

                        <tr>
                            <th>Designation</th>
                            <td>@Model.Designation</td>
                        </tr>

                        <tr>
                            <th>Department</th>
                            <td>@Model.Department?.DepartmentName</td>
                        </tr>

                        <tr>
                            <th>Salary</th>
                            <td>₹ @Model.Salary</td>
                        </tr>

                        <tr>
                            <th>Joining Date</th>
                            <td>@Model.JoiningDate.ToString("dd-MM-yyyy")</td>
                        </tr>

                        <tr>
                            <th>Status</th>
                            <td>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                        </tr>

                        <tr>
                            <th>Address</th>
                            <td>@Model.Address</td>
                        </tr>

                    </table>

                    <a asp-action="Edit"
                       asp-route-id="@Model.EmployeeId"
                       class="btn btn-warning">
                        <i class="bi bi-pencil-square"></i>
                        Edit
                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Back
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>