@model IEnumerable<EmployeeManagementSystem.Models.Employee>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Employees";
}

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>
            <i class="bi bi-people-fill"></i>
            Employee List
        </h2>

        @if (User.IsInRole("Admin") || User.IsInRole("HR"))
        {
            <a asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-person-plus-fill"></i>
                Add Employee

            </a>
        }

    </div>


    <!-- Search -->
    <div class="card shadow mb-3">

        <div class="card-body">

            <form asp-action="Index"
                  method="get">

                <div class="row g-2">

                    <div class="col-md-10">

                        <input type="text"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               class="form-control"
                               placeholder="Search by Code, Name, Email or Department..." />

                    </div>

                    <div class="col-md-2">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-search"></i>
                            Search

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Employee Table -->
    <div class="card shadow">

        <div class="card-body">

            <div class="table-responsive">

                <table id="employeeTable"
                       class="table table-striped table-hover table-bordered nowrap"
                       style="width:100%">

                    <thead class="table-dark">

                        <tr>

                            <th>Photo</th>

                            <th>Code</th>

                            <th>Name</th>

                            <th>Department</th>

                            <th>Designation</th>

                            <th>Salary</th>

                            <th>Status</th>

                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- Photo -->
                                <td>

                                    @if (!string.IsNullOrEmpty(item.PhotoPath))
                                    {
                                        <img src="@item.PhotoPath"
                                             width="60"
                                             height="60"
                                             class="rounded-circle border"
                                             style="object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <img src="~/images/default-user.png"
                                             width="60"
                                             height="60"
                                             class="rounded-circle border"
                                             style="object-fit:cover;" />
                                    }

                                </td>


                                <!-- Employee Code -->
                                <td>
                                    @item.EmployeeCode
                                </td>


                                <!-- Name -->
                                <td>
                                    @item.Name
                                </td>


                                <!-- Department -->
                                <td>
                                    @item.Department?.DepartmentName
                                </td>


                                <!-- Designation -->
                                <td>
                                    @item.Designation
                                </td>


                                <!-- Salary -->
                                <td>
                                    ₹ @item.Salary.ToString("N2")
                                </td>


                                <!-- Status -->
                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle"></i>
                                            Inactive
                                        </span>
                                    }

                                </td>


                                <!-- Actions -->
                                <td>

                                    <!-- Details -->
                                    <a asp-action="Details"
                                       asp-route-id="@item.EmployeeId"
                                       class="btn btn-info btn-sm"
                                       title="Details">

                                        <i class="bi bi-eye-fill"></i>

                                    </a>


                                    @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                                    {
                                        <!-- Edit -->
                                        <a asp-action="Edit"
                                           asp-route-id="@item.EmployeeId"
                                           class="btn btn-warning btn-sm"
                                           title="Edit">

                                            <i class="bi bi-pencil-fill"></i>

                                        </a>


                                        <!-- Delete -->
                                        <a asp-action="Delete"
                                           asp-route-id="@item.EmployeeId"
                                           class="btn btn-danger btn-sm"
                                           title="Delete">

                                            <i class="bi bi-trash-fill"></i>

                                        </a>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        $(document).ready(function () {

            $('#employeeTable').DataTable({

                responsive: true,

                pageLength: 10,

                lengthMenu: [10, 25, 50, 100],

                ordering: true,

                language: {

                    search: "🔍 Search:",

                    lengthMenu: "Show _MENU_ Employees",

                    zeroRecords: "No Employee Found",

                    info: "Showing _START_ to _END_ of _TOTAL_ Employees"

                }

            });

        });

    </script>

}