@model IEnumerable<EmployeeManagementSystem.Models.Payroll>

@{
    Layout = "_AdminLayout";

    ViewData["Title"] = "Reports";

    var payrolls = Model?.ToList()
        ?? new List<EmployeeManagementSystem.Models.Payroll>();


    // ==========================================
    // PAYROLL SUMMARY
    // ==========================================

    var totalPayroll = payrolls.Sum(p => p.NetSalary);

    var paidPayroll = payrolls
        .Where(p => p.PaymentStatus == "Paid")
        .Sum(p => p.NetSalary);

    var pendingPayroll = payrolls
        .Where(p => p.PaymentStatus == "Pending")
        .Sum(p => p.NetSalary);

    var paidCount = payrolls
        .Count(p => p.PaymentStatus == "Paid");

    var pendingCount = payrolls
        .Count(p => p.PaymentStatus == "Pending");
}


<div class="container-fluid reports-page">


    <!-- ==========================================
         HEADER
         ========================================== -->

    <div class="report-header">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-bar-chart-fill me-2"></i>

                Reports

            </h2>

            <p class="text-muted mb-0">
                Payroll and employee reports.
            </p>

        </div>


        <!-- ==========================================
             REPORT ACTIONS
             ========================================== -->

        <div class="report-actions">

            <!-- ATTENDANCE REPORT -->

            <a asp-action="Attendance"
               class="btn btn-outline-primary me-2">

                <i class="bi bi-calendar-check me-2"></i>

                Attendance Report

            </a>


            <!-- LEAVE REPORT -->

            <a asp-action="Leave"
               class="btn btn-outline-danger me-2">

                <i class="bi bi-calendar2-x me-2"></i>

                Leave Report

            </a>


            <!-- PRINT -->

            <button type="button"
                    onclick="window.print()"
                    class="btn btn-dark">

                <i class="bi bi-printer me-2"></i>

                Print Report

            </button>

        </div>

    </div>


    <!-- ==========================================
         PAYROLL FILTER
         ========================================== -->

    <div class="card shadow-sm filter-card">

        <div class="card-body">

            <form asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">


                    <!-- ==========================================
                         MONTH
                         ========================================== -->

                    <div class="col-md-4">

                        <label class="form-label fw-bold">
                            Month
                        </label>

                        <select name="month"
                                class="form-select">

                            @if (ViewBag.Month == null)
                            {
                                <option value="" selected>
                                    All Months
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    All Months
                                </option>
                            }


                            @for (int i = 1; i <= 12; i++)
                            {
                                if (ViewBag.Month == i)
                                {
                                    <option value="@i" selected>

                                        @(
                                            new DateTime(
                                                2000,
                                                i,
                                                1
                                            ).ToString("MMMM")
                                        )

                                    </option>
                                }
                                else
                                {
                                    <option value="@i">

                                        @(
                                            new DateTime(
                                                2000,
                                                i,
                                                1
                                            ).ToString("MMMM")
                                        )

                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- ==========================================
                         YEAR
                         ========================================== -->

                    <div class="col-md-4">

                        <label class="form-label fw-bold">
                            Year
                        </label>

                        <select name="year"
                                class="form-select">

                            @if (ViewBag.Year == null)
                            {
                                <option value="" selected>
                                    All Years
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    All Years
                                </option>
                            }


                            @for (
                                int y = DateTime.Today.Year - 2;
                                y <= DateTime.Today.Year + 1;
                                y++)
                            {
                                if (ViewBag.Year == y)
                                {
                                    <option value="@y" selected>
                                        @y
                                    </option>
                                }
                                else
                                {
                                    <option value="@y">
                                        @y
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- ==========================================
                         BUTTONS
                         ========================================== -->

                    <div class="col-md-4">

                        <button type="submit"
                                class="btn btn-primary me-2">

                            <i class="bi bi-filter me-2"></i>

                            Apply Filter

                        </button>


                        <a asp-action="Index"
                           class="btn btn-secondary">

                            <i class="bi bi-arrow-counterclockwise me-1"></i>

                            Reset

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ==========================================
         SUMMARY
         ========================================== -->

    <div class="summary-row">


        <!-- TOTAL PAYROLL -->

        <div class="summary-column">

            <div class="card shadow-sm border-0 summary-card">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Payroll
                    </h6>

                    <h3 class="fw-bold">

                        ₹ @totalPayroll.ToString("N2")

                    </h3>

                </div>

            </div>

        </div>


        <!-- PAID PAYROLL -->

        <div class="summary-column">

            <div class="card shadow-sm border-0 summary-card">

                <div class="card-body">

                    <h6 class="text-muted">
                        Paid Payroll
                    </h6>

                    <h3 class="fw-bold text-success">

                        ₹ @paidPayroll.ToString("N2")

                    </h3>

                    <small>
                        @paidCount paid records
                    </small>

                </div>

            </div>

        </div>


        <!-- PENDING PAYROLL -->

        <div class="summary-column">

            <div class="card shadow-sm border-0 summary-card">

                <div class="card-body">

                    <h6 class="text-muted">
                        Pending Payroll
                    </h6>

                    <h3 class="fw-bold text-warning">

                        ₹ @pendingPayroll.ToString("N2")

                    </h3>

                    <small>
                        @pendingCount pending records
                    </small>

                </div>

            </div>

        </div>


        <!-- TOTAL RECORDS -->

        <div class="summary-column">

            <div class="card shadow-sm border-0 summary-card">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Records
                    </h6>

                    <h3 class="fw-bold text-primary">

                        @payrolls.Count

                    </h3>

                </div>

            </div>

        </div>

    </div>


    <!-- ==========================================
         PAYROLL REPORT TABLE
         ========================================== -->

    <div class="card shadow-sm report-card">

        <div class="card-header bg-dark text-white">

            <h5 class="mb-0">

                <i class="bi bi-table me-2"></i>

                Payroll Report

            </h5>

        </div>


        <div class="card-body">

            <div class="table-responsive">

                <table id="reportTable"
                       class="table table-striped table-hover table-bordered">

                    <thead class="table-dark">

                        <tr>

                            <th>#</th>

                            <th>Employee</th>

                            <th>Code</th>

                            <th>Period</th>

                            <th>Basic Salary</th>

                            <th>Allowances</th>

                            <th>Deductions</th>

                            <th>Net Salary</th>

                            <th>Status</th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            int counter = 1;
                        }


                        @foreach (var item in payrolls)
                        {
                            <tr>


                                <!-- NUMBER -->

                                <td>
                                    @counter
                                </td>


                                <!-- EMPLOYEE -->

                                <td>

                                    <strong>
                                        @(item.Employee?.Name ?? "N/A")
                                    </strong>

                                </td>


                                <!-- CODE -->

                                <td>
                                    @(item.Employee?.EmployeeCode ?? "N/A")
                                </td>


                                <!-- PERIOD -->

                                <td>

                                    @(
                                        new DateTime(
                                            item.PayrollYear,
                                            item.PayrollMonth,
                                            1
                                        ).ToString("MMM yyyy")
                                    )

                                </td>


                                <!-- BASIC SALARY -->

                                <td>

                                    ₹ @item.BasicSalary.ToString("N2")

                                </td>


                                <!-- ALLOWANCES -->

                                <td class="text-success">

                                    + ₹ @item.Allowances.ToString("N2")

                                </td>


                                <!-- DEDUCTIONS -->

                                <td class="text-danger">

                                    - ₹ @item.Deductions.ToString("N2")

                                </td>


                                <!-- NET SALARY -->

                                <td>

                                    <strong>

                                        ₹ @item.NetSalary.ToString("N2")

                                    </strong>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (item.PaymentStatus == "Paid")
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-check-circle me-1"></i>

                                            Paid

                                        </span>
                                    }
                                    else if (item.PaymentStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">

                                            <i class="bi bi-hourglass-split me-1"></i>

                                            Pending

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            @(item.PaymentStatus ?? "Unknown")

                                        </span>
                                    }

                                </td>

                            </tr>

                            counter++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- ==========================================
     PAGE CSS
     ========================================== -->

<style>


    /* ==========================================
       MAIN PAGE
       ========================================== */

    .reports-page {

        display: block !important;

        width: 100% !important;

        max-width: 100% !important;

    }


    /* ==========================================
       HEADER
       ========================================== */

    .reports-page .report-header {

        display: flex;

        justify-content: space-between !important;

        align-items: center !important;

        width: 100% !important;

        margin-bottom: 1.5rem;

    }


    .reports-page .report-actions {

        display: flex;

        align-items: center;

        flex-wrap: wrap;

        gap: 0.25rem;

    }


    /* ==========================================
       FILTER
       ========================================== */

    .reports-page .filter-card {

        display: block !important;

        width: 100% !important;

        margin-bottom: 1.5rem;

    }


    /* ==========================================
       SUMMARY
       ========================================== */

    .reports-page .summary-row {

        display: flex !important;

        flex-wrap: wrap !important;

        width: 100% !important;

        margin-left: 0 !important;

        margin-right: 0 !important;

        margin-bottom: 1.5rem;

    }


    .reports-page .summary-column {

        flex: 0 0 25% !important;

        max-width: 25% !important;

        width: 25% !important;

        padding-left: 0.5rem;

        padding-right: 0.5rem;

    }


    .reports-page .summary-card {

        width: 100% !important;

        min-height: 130px;

    }


    .reports-page .summary-card h6 {

        white-space: nowrap;

    }


    .reports-page .summary-card h3 {

        white-space: nowrap;

        font-size: 1.5rem;

    }


    /* ==========================================
       REPORT TABLE
       ========================================== */

    .reports-page .report-card {

        display: block !important;

        width: 100% !important;

        max-width: 100% !important;

    }


    .reports-page .table-responsive {

        width: 100% !important;

        overflow-x: auto !important;

    }


    .reports-page #reportTable {

        width: 100% !important;

        min-width: 1000px;

    }


    .reports-page #reportTable th,

    .reports-page #reportTable td {

        white-space: nowrap;

        vertical-align: middle;

    }


    /* ==========================================
       BADGES
       ========================================== */

    .reports-page .badge {

        font-size: 0.85rem;

        padding: 0.45rem 0.65rem;

    }


    /* ==========================================
       RESPONSIVE
       ========================================== */

    @@media (max-width: 992px) {

        .reports-page .summary-column {

            flex: 0 0 50% !important;

            max-width: 50% !important;

            width: 50% !important;

        }

    }


    @@media (max-width: 768px) {

        .reports-page .report-header {

            display: block !important;

        }


        .reports-page .report-actions {

            margin-top: 1rem;

        }

    }


    @@media (max-width: 576px) {

        .reports-page .summary-column {

            flex: 0 0 100% !important;

            max-width: 100% !important;

            width: 100% !important;

        }


        .reports-page .report-actions {

            display: flex;

            flex-direction: column;

            align-items: stretch;

        }


        .reports-page .report-actions .btn {

            width: 100%;

            margin-right: 0 !important;

        }

    }


    /* ==========================================
       PRINT
       ========================================== */

    @@media print {

        .navbar,

        aside,

        .btn,

        .report-actions,

        .dataTables_filter,

        .dataTables_length,

        .dataTables_paginate,

        .dataTables_info {

            display: none !important;

        }


        body {

            background: white !important;

        }


        .reports-page {

            width: 100% !important;

        }


        .card {

            box-shadow: none !important;

            border: none !important;

        }


        .summary-row {

            display: flex !important;

        }


        .summary-column {

            flex: 0 0 25% !important;

            max-width: 25% !important;

        }

    }

</style>


<!-- ==========================================
     DATATABLE
     ========================================== -->

@section Scripts {

    <script>

        $(document).ready(function () {

            $('#reportTable').DataTable({

                responsive: false,

                scrollX: true,

                pageLength: 10,

                lengthMenu: [10, 25, 50, 100],

                ordering: true,

                order: [[3, 'desc']]

            });

        });

    </script>

}