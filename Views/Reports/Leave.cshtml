@model IEnumerable<EmployeeManagementSystem.Models.Leave>

@{
    Layout = "_AdminLayout";

    ViewData["Title"] = "Leave Report";

    var leaves = Model?.ToList()
        ?? new List<EmployeeManagementSystem.Models.Leave>();


    // ==========================================
    // SUMMARY
    // ==========================================

    var totalLeaves = leaves.Count;

    var pendingCount = leaves.Count(l =>
        l.Status == "Pending");

    var approvedCount = leaves.Count(l =>
        l.Status == "Approved");

    var rejectedCount = leaves.Count(l =>
        l.Status == "Rejected");


    // ==========================================
    // TOTAL LEAVE DAYS
    // ==========================================

    var totalLeaveDays = leaves.Sum(l =>
        (l.EndDate.Date - l.StartDate.Date).Days + 1);
}


<div class="container-fluid leave-report">

    <!-- ==========================================
         HEADER
         ========================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">

                <i class="bi bi-calendar2-x me-2"></i>

                Leave Report

            </h2>

            <p class="text-muted mb-0">
                Employee leave report.
            </p>

        </div>


        <div>

            <button type="button"
                    onclick="window.print()"
                    class="btn btn-dark me-2">

                <i class="bi bi-printer me-2"></i>

                Print Report

            </button>


            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left me-2"></i>

                Back to Reports

            </a>

        </div>

    </div>


    <!-- ==========================================
         FILTER
         ========================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Leave"
                  method="get"
                  class="row g-3 align-items-end">


                <!-- EMPLOYEE -->

                <div class="col-lg-3 col-md-6">

                    <label class="form-label fw-bold">
                        Employee
                    </label>

                    <select name="employeeId"
                            class="form-select">

                        <option value="">
                            All Employees
                        </option>

                        @foreach (var employee in ViewBag.Employees)
                        {
                            if (ViewBag.SelectedEmployee ==
                                employee.EmployeeId)
                            {
                                <option value="@employee.EmployeeId"
                                        selected>
                                    @employee.Name
                                </option>
                            }
                            else
                            {
                                <option value="@employee.EmployeeId">
                                    @employee.Name
                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- LEAVE TYPE -->

                <div class="col-lg-3 col-md-6">

                    <label class="form-label fw-bold">
                        Leave Type
                    </label>

                    <select name="leaveType"
                            class="form-select">

                        @if (string.IsNullOrWhiteSpace(
                            ViewBag.SelectedLeaveType as string))
                        {
                            <option value="" selected>
                                All Leave Types
                            </option>
                        }
                        else
                        {
                            <option value="">
                                All Leave Types
                            </option>
                        }


                        @if (ViewBag.SelectedLeaveType == "Casual Leave")
                        {
                            <option value="Casual Leave" selected>
                                Casual Leave
                            </option>
                        }
                        else
                        {
                            <option value="Casual Leave">
                                Casual Leave
                            </option>
                        }


                        @if (ViewBag.SelectedLeaveType == "Sick Leave")
                        {
                            <option value="Sick Leave" selected>
                                Sick Leave
                            </option>
                        }
                        else
                        {
                            <option value="Sick Leave">
                                Sick Leave
                            </option>
                        }


                        @if (ViewBag.SelectedLeaveType == "Earned Leave")
                        {
                            <option value="Earned Leave" selected>
                                Earned Leave
                            </option>
                        }
                        else
                        {
                            <option value="Earned Leave">
                                Earned Leave
                            </option>
                        }


                        @if (ViewBag.SelectedLeaveType == "Unpaid Leave")
                        {
                            <option value="Unpaid Leave" selected>
                                Unpaid Leave
                            </option>
                        }
                        else
                        {
                            <option value="Unpaid Leave">
                                Unpaid Leave
                            </option>
                        }

                    </select>

                </div>


                <!-- MONTH -->

                <div class="col-lg-2 col-md-6">

                    <label class="form-label fw-bold">
                        Month
                    </label>

                    <select name="month"
                            class="form-select">

                        @if (ViewBag.SelectedMonth == null)
                        {
                            <option value="" selected>
                                All Months
                            </option>
                        }
                        else
                        {
                            <option value="">
                                All Months
                            </option>
                        }


                        @for (int i = 1; i <= 12; i++)
                        {
                            if (ViewBag.SelectedMonth == i)
                            {
                                <option value="@i" selected>
                                    @(new DateTime(2000, i, 1)
                                        .ToString("MMMM"))
                                </option>
                            }
                            else
                            {
                                <option value="@i">
                                    @(new DateTime(2000, i, 1)
                                        .ToString("MMMM"))
                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- YEAR -->

                <div class="col-lg-2 col-md-6">

                    <label class="form-label fw-bold">
                        Year
                    </label>

                    <select name="year"
                            class="form-select">

                        @if (ViewBag.SelectedYear == null)
                        {
                            <option value="" selected>
                                All Years
                            </option>
                        }
                        else
                        {
                            <option value="">
                                All Years
                            </option>
                        }


                        @for (
                            int y = DateTime.Today.Year - 2;
                            y <= DateTime.Today.Year;
                            y++)
                        {
                            if (ViewBag.SelectedYear == y)
                            {
                                <option value="@y" selected>
                                    @y
                                </option>
                            }
                            else
                            {
                                <option value="@y">
                                    @y
                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- STATUS -->

                <div class="col-lg-2 col-md-6">

                    <label class="form-label fw-bold">
                        Status
                    </label>

                    <select name="status"
                            class="form-select">

                        @if (string.IsNullOrWhiteSpace(
                            ViewBag.SelectedStatus as string))
                        {
                            <option value="" selected>
                                All Status
                            </option>
                        }
                        else
                        {
                            <option value="">
                                All Status
                            </option>
                        }


                        @foreach (var item in new[]
                        {
                            "Pending",
                            "Approved",
                            "Rejected"
                        })
                        {
                            if (ViewBag.SelectedStatus == item)
                            {
                                <option value="@item" selected>
                                    @item
                                </option>
                            }
                            else
                            {
                                <option value="@item">
                                    @item
                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- BUTTONS -->

                <div class="col-12">

                    <button type="submit"
                            class="btn btn-primary me-2">

                        <i class="bi bi-funnel me-1"></i>

                        Apply Filter

                    </button>


                    <a asp-action="Leave"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-counterclockwise me-1"></i>

                        Reset

                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- ==========================================
         SUMMARY CARDS
         ========================================== -->

    <div class="row g-3 mb-4">


        <!-- TOTAL -->

        <div class="col-xl col-lg-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Leaves
                    </h6>

                    <h3 class="fw-bold text-primary">
                        @totalLeaves
                    </h3>

                </div>

            </div>

        </div>


        <!-- PENDING -->

        <div class="col-xl col-lg-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Pending
                    </h6>

                    <h3 class="fw-bold text-warning">
                        @pendingCount
                    </h3>

                </div>

            </div>

        </div>


        <!-- APPROVED -->

        <div class="col-xl col-lg-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Approved
                    </h6>

                    <h3 class="fw-bold text-success">
                        @approvedCount
                    </h3>

                </div>

            </div>

        </div>


        <!-- REJECTED -->

        <div class="col-xl col-lg-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Rejected
                    </h6>

                    <h3 class="fw-bold text-danger">
                        @rejectedCount
                    </h3>

                </div>

            </div>

        </div>


        <!-- TOTAL DAYS -->

        <div class="col-xl col-lg-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Leave Days
                    </h6>

                    <h3 class="fw-bold text-info">
                        @totalLeaveDays
                    </h3>

                </div>

            </div>

        </div>

    </div>


    <!-- ==========================================
         LEAVE TABLE
         ========================================== -->

    <div class="card shadow-sm">


        <div class="card-header bg-dark text-white">

            <h5 class="mb-0">

                <i class="bi bi-table me-2"></i>

                Leave Records

            </h5>

        </div>


        <div class="card-body">

            <div class="table-responsive">

                <table id="leaveTable"
                       class="table table-striped table-hover table-bordered align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>#</th>

                            <th>Employee</th>

                            <th>Leave Type</th>

                            <th>Start Date</th>

                            <th>End Date</th>

                            <th>Days</th>

                            <th>Reason</th>

                            <th>Status</th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            int count = 1;
                        }


                        @foreach (var item in leaves)
                        {
                            var days =
                                (item.EndDate.Date -
                                 item.StartDate.Date).Days + 1;


                            <tr>

                                <!-- NUMBER -->

                                <td>
                                    @count
                                </td>


                                <!-- EMPLOYEE -->

                                <td>

                                    <strong>
                                        @(item.Employee?.Name ?? "N/A")
                                    </strong>

                                    <br />

                                    <small class="text-muted">
                                        @(item.Employee?.EmployeeCode ?? "N/A")
                                    </small>

                                </td>


                                <!-- LEAVE TYPE -->

                                <td>

                                    <span class="badge bg-secondary">
                                        @item.LeaveType
                                    </span>

                                </td>


                                <!-- START -->

                                <td>
                                    @item.StartDate.ToString("dd-MM-yyyy")
                                </td>


                                <!-- END -->

                                <td>
                                    @item.EndDate.ToString("dd-MM-yyyy")
                                </td>


                                <!-- DAYS -->

                                <td>

                                    <span class="badge bg-info text-dark">

                                        @days day(s)

                                    </span>

                                </td>


                                <!-- REASON -->

                                <td>

                                    @if (string.IsNullOrWhiteSpace(item.Reason))
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }
                                    else
                                    {
                                        @item.Reason
                                    }

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">

                                            <i class="bi bi-hourglass-split me-1"></i>

                                            Pending

                                        </span>
                                    }
                                    else if (item.Status == "Approved")
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-check-circle me-1"></i>

                                            Approved

                                        </span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">

                                            <i class="bi bi-x-circle me-1"></i>

                                            Rejected

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            @item.Status

                                        </span>
                                    }

                                </td>

                            </tr>

                            count++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- ==========================================
     CSS
     ========================================== -->

<style>

    .leave-report {
        width: 100%;
    }


    .leave-report .card {
        border-radius: 10px;
    }


    .leave-report .card-header {
        border-radius: 10px 10px 0 0;
    }


    .leave-report th,
    .leave-report td {
        vertical-align: middle;
        white-space: nowrap;
    }


    .leave-report .badge {
        font-size: 0.85rem;
        padding: 0.5rem 0.7rem;
    }


    @@media (max-width: 768px) {

        .leave-report .d-flex {
            display: block !important;
        }

        .leave-report .d-flex > div:last-child {
            margin-top: 1rem;
        }

    }


    @@media print {

        aside,
        .navbar,
        .btn,
        .dataTables_filter,
        .dataTables_length,
        .dataTables_paginate,
        .dataTables_info {
            display: none !important;
        }


        body {
            background: white !important;
        }


        .leave-report {
            width: 100% !important;
        }


        .leave-report .card {
            box-shadow: none !important;
            border: none !important;
        }


        .leave-report .card-header {
            background: white !important;
            color: black !important;
        }

    }

</style>


<!-- ==========================================
     DATATABLE
     ========================================== -->

@section Scripts {

    <script>

        $(document).ready(function () {

            $('#leaveTable').DataTable({

                responsive: false,

                scrollX: true,

                pageLength: 10,

                lengthMenu: [10, 25, 50, 100],

                ordering: true,

                order: [[3, 'desc']]

            });

        });

    </script>

}