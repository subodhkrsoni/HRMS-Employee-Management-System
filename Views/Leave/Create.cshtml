@model EmployeeManagementSystem.Models.Leave

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Apply Leave";
}

<div class="container-fluid">

    <!-- ============================= -->
    <!-- HEADER -->
    <!-- ============================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-calendar-plus me-2"></i>
                Apply Leave
            </h2>

            <p class="text-muted mb-0">
                Submit a new employee leave application
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-2"></i>
            Back to Leave List

        </a>

    </div>


    <!-- ============================= -->
    <!-- FORM CARD -->
    <!-- ============================= -->

    <div class="row">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-primary text-white">

                    <h5 class="mb-0">

                        <i class="bi bi-file-earmark-text me-2"></i>

                        Leave Application

                    </h5>

                </div>


                <div class="card-body p-4">

                    <!-- Validation -->

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>


                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- ============================= -->
                        <!-- EMPLOYEE -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="EmployeeId"
                                   class="form-label fw-bold">

                                Employee
                                <span class="text-danger">*</span>

                            </label>

                            <select asp-for="EmployeeId"
                                    asp-items="ViewBag.Employees"
                                    class="form-select">

                                <option value="">
                                    -- Select Employee --
                                </option>

                            </select>

                            <span asp-validation-for="EmployeeId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- LEAVE TYPE -->
                        <!-- ============================= -->

                        <div class="mb-3">

                            <label asp-for="LeaveType"
                                   class="form-label fw-bold">

                                Leave Type
                                <span class="text-danger">*</span>

                            </label>

                            <select asp-for="LeaveType"
                                    class="form-select">

                                <option value="">
                                    -- Select Leave Type --
                                </option>

                                <option value="Casual Leave">
                                    Casual Leave
                                </option>

                                <option value="Sick Leave">
                                    Sick Leave
                                </option>

                                <option value="Earned Leave">
                                    Earned Leave
                                </option>

                                <option value="Unpaid Leave">
                                    Unpaid Leave
                                </option>

                                <option value="Maternity Leave">
                                    Maternity Leave
                                </option>

                                <option value="Paternity Leave">
                                    Paternity Leave
                                </option>

                            </select>

                            <span asp-validation-for="LeaveType"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- DATES -->
                        <!-- ============================= -->

                        <div class="row">

                            <!-- Start Date -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="StartDate"
                                       class="form-label fw-bold">

                                    Start Date
                                    <span class="text-danger">*</span>

                                </label>

                                <input asp-for="StartDate"
                                       type="date"
                                       class="form-control"
                                       id="startDate" />

                                <span asp-validation-for="StartDate"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- End Date -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="EndDate"
                                       class="form-label fw-bold">

                                    End Date
                                    <span class="text-danger">*</span>

                                </label>

                                <input asp-for="EndDate"
                                       type="date"
                                       class="form-control"
                                       id="endDate" />

                                <span asp-validation-for="EndDate"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- ============================= -->
                        <!-- TOTAL DAYS -->
                        <!-- ============================= -->

                        <div class="alert alert-info d-none"
                             id="daysInfo">

                            <i class="bi bi-calendar3 me-2"></i>

                            Total Leave Days:

                            <strong id="totalDays">
                                0
                            </strong>

                        </div>


                        <!-- ============================= -->
                        <!-- REASON -->
                        <!-- ============================= -->

                        <div class="mb-4">

                            <label asp-for="Reason"
                                   class="form-label fw-bold">

                                Reason
                                <span class="text-danger">*</span>

                            </label>

                            <textarea asp-for="Reason"
                                      class="form-control"
                                      rows="4"
                                      maxlength="500"
                                      placeholder="Enter reason for leave..."></textarea>

                            <div class="form-text">
                                Maximum 500 characters.
                            </div>

                            <span asp-validation-for="Reason"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ============================= -->
                        <!-- STATUS -->
                        <!-- ============================= -->

                        <div class="mb-4">

                            <label class="form-label fw-bold">
                                Status
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="Pending"
                                   readonly />

                            <div class="form-text">
                                New leave applications are automatically
                                submitted as Pending.
                            </div>

                        </div>


                        <!-- ============================= -->
                        <!-- BUTTONS -->
                        <!-- ============================= -->

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-send me-2"></i>

                                Submit Leave

                            </button>


                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-x-circle me-2"></i>

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>


        <!-- ============================= -->
        <!-- INFORMATION CARD -->
        <!-- ============================= -->

        <div class="col-lg-4">

            <div class="card shadow-sm border-0 mb-3">

                <div class="card-header bg-dark text-white">

                    <h5 class="mb-0">

                        <i class="bi bi-info-circle me-2"></i>

                        Leave Information

                    </h5>

                </div>

                <div class="card-body">

                    <div class="mb-3">

                        <span class="badge bg-primary">
                            Casual Leave
                        </span>

                        <small class="d-block text-muted mt-1">
                            Personal or casual requirements.
                        </small>

                    </div>

                    <div class="mb-3">

                        <span class="badge bg-danger">
                            Sick Leave
                        </span>

                        <small class="d-block text-muted mt-1">
                            Leave due to illness or medical reasons.
                        </small>

                    </div>

                    <div class="mb-3">

                        <span class="badge bg-success">
                            Earned Leave
                        </span>

                        <small class="d-block text-muted mt-1">
                            Planned or earned vacation leave.
                        </small>

                    </div>

                    <div class="mb-3">

                        <span class="badge bg-secondary">
                            Unpaid Leave
                        </span>

                        <small class="d-block text-muted mt-1">
                            Leave without salary.
                        </small>

                    </div>

                </div>

            </div>


            <!-- Rules -->

            <div class="card shadow-sm border-0">

                <div class="card-header bg-warning">

                    <h5 class="mb-0">

                        <i class="bi bi-exclamation-triangle me-2"></i>

                        Important Rules

                    </h5>

                </div>

                <div class="card-body">

                    <ul class="mb-0">

                        <li class="mb-2">
                            Start date cannot be after end date.
                        </li>

                        <li class="mb-2">
                            Leave cannot start in the past.
                        </li>

                        <li class="mb-2">
                            Overlapping leave is not allowed.
                        </li>

                        <li class="mb-2">
                            New applications start as Pending.
                        </li>

                        <li>
                            HR/Admin must approve the request.
                        </li>

                    </ul>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        $(document).ready(function () {

            // ==========================================
            // MINIMUM DATE = TODAY
            // ==========================================

            const today =
                new Date().toISOString().split('T')[0];

            $('#startDate').attr('min', today);

            $('#endDate').attr('min', today);


            // ==========================================
            // START DATE CHANGE
            // ==========================================

            $('#startDate').on('change', function () {

                const startDate = $(this).val();

                if (startDate) {

                    $('#endDate').attr(
                        'min',
                        startDate
                    );

                }

                calculateDays();

            });


            // ==========================================
            // END DATE CHANGE
            // ==========================================

            $('#endDate').on('change', function () {

                calculateDays();

            });


            // ==========================================
            // CALCULATE LEAVE DAYS
            // ==========================================

            function calculateDays() {

                const start =
                    $('#startDate').val();

                const end =
                    $('#endDate').val();

                if (!start || !end) {

                    $('#daysInfo')
                        .addClass('d-none');

                    return;
                }

                const startDate =
                    new Date(start);

                const endDate =
                    new Date(end);

                if (endDate < startDate) {

                    $('#daysInfo')
                        .removeClass('d-none');

                    $('#totalDays')
                        .text('Invalid date range');

                    return;
                }

                const difference =
                    endDate.getTime() -
                    startDate.getTime();

                const days =
                    Math.floor(
                        difference /
                        (1000 * 60 * 60 * 24)
                    ) + 1;

                $('#daysInfo')
                    .removeClass('d-none');

                $('#totalDays')
                    .text(days);

            }

        });

    </script>
}